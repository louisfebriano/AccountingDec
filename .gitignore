# Foto nota nyata bersifat lokal. Struktur folder dan petunjuk tetap dilacak,
# tetapi file gambar pengguna tidak masuk repository secara tidak sengaja.
/data/processed/image/*
!/data/processed/image/README.md
!/data/processed/image/train/
!/data/processed/image/validation/
!/data/processed/image/evaluation/
/data/processed/image/train/*
