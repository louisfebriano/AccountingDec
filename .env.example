HF_TOKEN=your_huggingface_token_here
DATABASE_URL=
DATABASE_POOL_MODE=session
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_TRANSACTIONS_TABLE=transactions
DATABASE_RECEIPTS_TABLE=receipts
DATABASE_RECEIPT_ITEMS_TABLE=receipt_items
DATABASE_AUDIT_LOGS_TABLE=audit_logs

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
AUTH_ACCESS_COOKIE_NAME=catatkas_access_token
AUTH_REFRESH_COOKIE_NAME=catatkas_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=2592000
AUDIT_LOG_ENABLED=true
# ---- Login otomatis mode demo ----
# true membuat PWA mencoba login otomatis memakai akun di bawah, sehingga
# pengunjung dapat mencoba aplikasi tanpa mengisi form login. Semua pengunjung
# berbagi satu akun. Kredensial hanya dibaca di server. Matikan di produksi.
AUTO_LOGIN_ENABLED=false
AUTO_LOGIN_EMAIL=testing@yopmail.com
AUTO_LOGIN_PASSWORD=123123123
MODEL_WARMUP_ON_STARTUP=true

# ---- Deployment: server publik (Render) ----
# AI_SERVICE_URL diisi bila ekstraksi diteruskan ke laptop via Cloudflare Tunnel.
# Kosongkan pada pemakaian lokal agar pipeline AI berjalan di proses ini.
AI_SERVICE_URL=
# Token yang dikirim server publik ke laptop (samakan dengan AI_TRUST_INTERNAL_TOKEN).
AI_INTERNAL_TOKEN=
AI_CONNECT_TIMEOUT_SECONDS=10
AI_REQUEST_TIMEOUT_SECONDS=90

# ---- Deployment: laptop sebagai layanan AI ----
# Hanya diisi pada .env laptop. Jangan diisi di server publik.
AI_TRUST_INTERNAL_TOKEN=

WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=id
WHISPER_VAD_FILTER=true
AUDIO_MAX_SIZE_MB=10
VOICE_LLM_NORMALIZATION_ENABLED=true
VOICE_LLM_NORMALIZATION_MAX_NEW_TOKENS=96
# Log berkas input suara (satu baris JSON per tahap). Console uvicorn tetap
# menampilkan [voice:<id>] walau opsi ini dimatikan.
VOICE_LOG_ENABLED=true
VOICE_LOG_PATH=logs/voice.log
VOICE_LOG_MAX_BYTES=5242880
VOICE_LOG_BACKUP_COUNT=3
RECEIPT_MAX_SIZE_MB=10
RECEIPT_OCR_LANGUAGE=id
RECEIPT_MIN_CONFIDENCE=0.50
RECEIPT_MAX_IMAGE_DIMENSION=2400
RECEIPT_OCR_TARGET_LONG_EDGE=2000
RECEIPT_MAX_IMAGE_PIXELS=25000000
RECEIPT_OCR_MULTIPASS=true
RECEIPT_OCR_COMPACT_FOR_MODEL=true
RECEIPT_OCR_DET_BOX_THRESHOLD=0.30
RECEIPT_OCR_DROP_SCORE=0.25
RECEIPT_ADAPTER_OUTPUT_DIR=adapters/soft-prompt-nota
RECEIPT_TRAIN_DATA_PATH=data/processed/receipt-train.jsonl
RECEIPT_VALIDATION_DATA_PATH=data/processed/receipt-validation.jsonl
RECEIPT_EVAL_DATA_PATH=data/processed/receipt-eval.jsonl
RECEIPT_IMAGE_DATA_DIR=data/processed/image
RECEIPT_ANNOTATION_DIR=data/processed/receipt-annotations
RECEIPT_REAL_TRAIN_DATA_PATH=data/processed/receipt-real-train.jsonl
RECEIPT_REAL_VALIDATION_DATA_PATH=data/processed/receipt-real-validation.jsonl
RECEIPT_REAL_EVAL_DATA_PATH=data/processed/receipt-real-eval.jsonl
RECEIPT_SOFT_PROMPT_CONTRACT_VERSION=1
RECEIPT_LLM_ENABLED=true
RECEIPT_RULE_FALLBACK_ENABLED=true
RECEIPT_MAX_SEQ_LENGTH=768
RECEIPT_MAX_NEW_TOKENS=768
RECEIPT_TRAIN_BATCH_SIZE=1
RECEIPT_GRADIENT_ACCUMULATION_STEPS=8
RECEIPT_MIN_FREE_GPU_GB=4.5
TRAIN_REFERENCE_DATE=2026-08-24
TRAIN_VALIDATION_DATA_PATH=data/processed/validation-six-fields.jsonl
TRAIN_REFERENCE_DATE_VARIANTS=4
TRAIN_REFERENCE_DATE_STEP_DAYS=7
TRAIN_VALIDATION_RATIO=0.1
TRAIN_SEED=42
BALANCE_TRANSACTION_TYPES=true
